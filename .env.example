# Authentik Configuration
AUTHENTIK_METADATA_URL=https://auth.woodburn.au/application/o/woodburn/.well-known/openid-configuration
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
# Optional: set internal URL for backend API calls (useful if Docker container/NAT cannot hairpin to public URL)
# AUTHENTIK_INTERNAL_URL=http://authentik-server:9000
# Optional: API timeouts in seconds (default: connect=5, api=15)
# AUTHENTIK_API_TIMEOUT=15
# Optional: set to true to hide internal apps if Authentik API fails or token is missing (default: false)
# AUTHENTIK_FILTER_FAIL_CLOSED=false

# App Secret Key (Generate a random string for production)
APP_SECRET_KEY=change-me-to-a-secure-random-string

# Server Concurrency (default: 2 workers, 4 threads = 8 concurrent connections)
# WORKERS=2
# THREADS=4


